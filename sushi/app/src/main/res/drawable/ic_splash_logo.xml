<?xml version="1.0" encoding="utf-8"?>
<!--
    素时 · 启动屏 Logo
    设计:"时之生长" (启动屏专用版)
    画布 288x288,内容居中,采用 splash screen 1/3 安全区
    - 朱砂色 #B23A48(中国红)
    - 居中竖向 S 曲线:从底部(种子)向上生长,顶部(日光)
    - 上下两个圆点:上为"日"(时间),下为"种"(起点)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- 主体 S 曲线:垂直方向,从下向上生长 -->
    <path
        android:pathData="M 120,200
                          C 120,184 144,172 168,160
                          C 192,148 216,136 216,116
                          C 216,96 192,88 168,96
                          C 152,100 140,108 132,120"
        android:strokeColor="#B23A48"
        android:strokeWidth="18"
        android:strokeLineCap="round" />

    <!-- 顶端"日":代表时间 -->
    <path
        android:pathData="M 156,72 m -14,0 a 14,14 0 1,0 28,0 a 14,14 0 1,0 -28,0"
        android:fillColor="#B23A48" />

    <!-- 底端"种":代表生长起点 -->
    <path
        android:pathData="M 144,224 m -10,0 a 10,10 0 1,0 20,0 a 10,10 0 1,0 -20,0"
        android:fillColor="#B23A48" />
</vector>
